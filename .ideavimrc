map <leader>b[ :bp<CR>
map <leader>b] :bn<CR>
map <leader>bb <action>(RecentFiles)
map <leader>bd :q<CR>
map <leader>bh :bp<CR>
map <leader>bi :ls<CR>
map <leader>bk :q<CR>
map <leader>bl :bn<CR>
map <leader>bn :bn<CR>
map <leader>bp :bp<CR>

